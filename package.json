{
  "name": "wanderlust",
  "version": "1.0.0",
  "description": "An Airbnb-like web application for travel accommodations",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "create:demo-user": "node scripts/createDemoUser.js",
    "seed:hosts": "node scripts/seedHostData.js",
    "test": "jest --watchAll --verbose",
    "test:coverage": "jest --coverage",
    "seed": "node seeds/index.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "airbnb",
    "travel",
    "accommodation",
    "booking"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cloudinary": "^1.41.0",
    "compression": "^1.8.1",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "ejs-mate": "^4.0.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "helmet": "^7.2.0",
    "joi": "^17.13.3",
    "method-override": "^3.0.0",
    "mongoose": "^7.8.7",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.7",
    "passport": "^0.6.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^8.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
