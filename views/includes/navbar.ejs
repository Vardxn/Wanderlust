<!-- Dynamic Liquid Glass Navbar -->
<header class="airbnb-header liquid-glass-nav-clean" id="liquidNavbar">
    <div class="nav-container">
        <div class="nav-left nav-animate" style="animation-delay: 0.1s;">
            <a href="/" class="logo-link">
                <span class="logo-text-clean">WANDERLUST</span>
            </a>
        </div>
        <div class="nav-center-clean nav-animate" style="animation-delay: 0.2s;">
            <a href="/stays" class="nav-pill-clean">
                <span>Stays</span>
            </a>
            <a href="/experiences" class="nav-pill-clean">
                <span>Experiences</span>
            </a>
        </div>
        <div class="nav-right-clean nav-animate" style="animation-delay: 0.3s;">
            <a href="/listings/new" class="host-link-clean">Become a Host</a>
            <div class="user-menu-container nav-animate" style="animation-delay: 0.4s;">
                <button class="user-menu-trigger-clean" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-bars"></i>
                    <div class="user-avatar-clean">
                        <i class="fas fa-user"></i>
                    </div>
                </button>
                <ul class="dropdown-menu user-dropdown-clean dropdown-menu-end" aria-labelledby="userMenuButton">
                    <li><a class="dropdown-item" href="/login">Log in</a></li>
                    <li><a class="dropdown-item" href="/register">Sign up</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="/listings/new">Host your home</a></li>
                    <li><a class="dropdown-item" href="/experiences/host">Host an experience</a></li>
                    <li><a class="dropdown-item" href="/help">Help</a></li>
                </ul>
            </div>
        </div>
    </div>
</header>

<script>
// Dynamic Liquid Glass Navbar - Apple-Style Scroll Animations
document.addEventListener('DOMContentLoaded', function() {
    const navbar = document.getElementById('liquidNavbar');
    const navPills = document.querySelectorAll('.nav-pill-clean');
    const currentPath = window.location.pathname;
    
    // Set active pill based on current path
    navPills.forEach(pill => {
        const href = pill.getAttribute('href');
        if ((currentPath === '/' || currentPath === '/stays' || currentPath === '/listings') && href === '/stays') {
            pill.classList.add('active');
        } else if (currentPath.startsWith('/experiences') && href === '/experiences') {
            pill.classList.add('active');
        }
    });
    
    // Dynamic scroll effect - Apple style
    let lastScroll = 0;
    let ticking = false;
    
    function updateNavbar() {
        const scrollPos = window.pageYOffset || document.documentElement.scrollTop;
        
        if (scrollPos > 0) {
            navbar.classList.add('navbar-scrolled');
        } else {
            navbar.classList.remove('navbar-scrolled');
        }
        
        lastScroll = scrollPos;
        ticking = false;
    }
    
    window.addEventListener('scroll', function() {
        if (!ticking) {
            window.requestAnimationFrame(updateNavbar);
            ticking = true;
        }
    });
    
    // Initial check
    updateNavbar();
});
</script>
