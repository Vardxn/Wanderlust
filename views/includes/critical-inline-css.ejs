body{margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#0A0E1A;color:#fff;overflow-x:hidden}.liquid-glass-nav-clean{position:fixed;top:0;left:0;width:100%;z-index:9999;background:transparent;transition:all .4s cubic-bezier(.4,0,.2,1)}.nav-container{max-width:1920px;margin:0 auto;padding:16px 40px;display:flex;align-items:center;justify-content:space-between}.logo-text-clean{font-size:1.5rem;font-weight:900;background:linear-gradient(135deg,#60A5FA 0%,#F9FAFB 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}.nav-center-clean{display:flex;gap:8px;background:rgba(255,255,255,.05);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,.08);border-radius:50px;padding:6px}.experiences-main,.listings-main{padding-top:100px;min-height:100vh}img{max-width:100%;height:auto;display:block}*{box-sizing:border-box}
