<% layout('../layouts/boilerplate') %>

<!-- =====================================================================
     HERO SCROLL-SEQUENCE SECTION
     Apple-style cinematic scroll animation
     ===================================================================== -->
<section id="hero-scroll-container" class="hero-scroll-section">
    <canvas id="hero-canvas"></canvas>
    <div class="hero-overlay">
        <div class="hero-content">
            <h1 class="hero-title" data-scroll-reveal>
                Experience Travel
                <br>
                <span class="gradient-text">Reimagined</span>
            </h1>
            <p class="hero-subtitle" data-scroll-reveal>
                Discover extraordinary stays in the world's most breathtaking destinations
            </p>
        </div>
    </div>
</section>

<!-- =====================================================================
     LIQUID GLASS SEARCH MODULE
     Floating above content with aurora border
     ===================================================================== -->
<section class="search-section">
    <div class="container">
        <div class="liquid-glass-search glass-interactive liquid-refraction">
            <div class="search-grid">
                <div class="search-field">
                    <label class="search-label">Where</label>
                    <input type="text" 
                           class="liquid-glass-input" 
                           placeholder="Search destinations"
                           id="search-location">
                </div>
                <div class="search-field">
                    <label class="search-label">Check in</label>
                    <input type="date" 
                           class="liquid-glass-input"
                           id="search-checkin">
                </div>
                <div class="search-field">
                    <label class="search-label">Check out</label>
                    <input type="date" 
                           class="liquid-glass-input"
                           id="search-checkout">
                </div>
                <div class="search-field">
                    <label class="search-label">Guests</label>
                    <select class="liquid-glass-input" id="search-guests">
                        <option>1 guest</option>
                        <option>2 guests</option>
                        <option>3 guests</option>
                        <option>4+ guests</option>
                    </select>
                </div>
                <div class="search-action">
                    <button class="liquid-glass-btn liquid-glass-btn-primary">
                        <i class="fas fa-search"></i>
                        Search
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =====================================================================
     FEATURE REVEAL SECTION
     Scroll-pinned feature highlights
     ===================================================================== -->
<section class="features-section">
    <div class="feature-item">
        <div class="feature-background" 
             style="background-image: url('https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1920');"
             data-parallax="0.3">
        </div>
        <div class="feature-content liquid-glass">
            <div class="feature-icon">
                <i class="fas fa-shield-check"></i>
            </div>
            <h2 class="feature-title">Verified Excellence</h2>
            <p class="feature-description">
                Every property is personally verified and inspected by our team to ensure 
                the highest standards of quality and authenticity.
            </p>
        </div>
    </div>

    <div class="feature-item">
        <div class="feature-background" 
             style="background-image: url('https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?w=1920');"
             data-parallax="0.3">
        </div>
        <div class="feature-content liquid-glass">
            <div class="feature-icon">
                <i class="fas fa-calendar-check"></i>
            </div>
            <h2 class="feature-title">Seamless Booking</h2>
            <p class="feature-description">
                Book your dream stay in seconds with our intuitive platform. 
                Instant confirmation, flexible cancellation, and 24/7 support.
            </p>
        </div>
    </div>

    <div class="feature-item">
        <div class="feature-background" 
             style="background-image: url('https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?w=1920');"
             data-parallax="0.3">
        </div>
        <div class="feature-content liquid-glass">
            <div class="feature-icon">
                <i class="fas fa-heart"></i>
            </div>
            <h2 class="feature-title">Curated with Care</h2>
            <p class="feature-description">
                Each listing is handpicked for its unique character, stunning design, 
                and exceptional location. Your perfect stay awaits.
            </p>
        </div>
    </div>
</section>

<!-- =====================================================================
     DESTINATION SHOWCASE
     Horizontal scroll gallery
     ===================================================================== -->
<section class="destination-showcase">
    <div class="container-fluid">
        <h2 class="section-title text-center mb-5">
            Explore Dream Destinations
        </h2>
        <div class="destination-scroll-wrapper">
            <div class="destination-card liquid-glass-card">
                <img src="https://images.unsplash.com/photo-1502602898657-3e91760cbb34?w=800" 
                     alt="Paris" 
                     class="destination-image">
                <div class="liquid-glass-card-overlay">
                    <h3 class="destination-name">Paris</h3>
                    <p class="destination-count">1,234 properties</p>
                </div>
            </div>

            <div class="destination-card liquid-glass-card">
                <img src="https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?w=800" 
                     alt="London" 
                     class="destination-image">
                <div class="liquid-glass-card-overlay">
                    <h3 class="destination-name">London</h3>
                    <p class="destination-count">987 properties</p>
                </div>
            </div>

            <div class="destination-card liquid-glass-card">
                <img src="https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?w=800" 
                     alt="Tokyo" 
                     class="destination-image">
                <div class="liquid-glass-card-overlay">
                    <h3 class="destination-name">Tokyo</h3>
                    <p class="destination-count">756 properties</p>
                </div>
            </div>

            <div class="destination-card liquid-glass-card">
                <img src="https://images.unsplash.com/photo-1534351590666-13e3e96b5017?w=800" 
                     alt="New York" 
                     class="destination-image">
                <div class="liquid-glass-card-overlay">
                    <h3 class="destination-name">New York</h3>
                    <p class="destination-count">1,543 properties</p>
                </div>
            </div>

            <div class="destination-card liquid-glass-card">
                <img src="https://images.unsplash.com/photo-1523906834658-6e24ef2386f9?w=800" 
                     alt="Barcelona" 
                     class="destination-image">
                <div class="liquid-glass-card-overlay">
                    <h3 class="destination-name">Barcelona</h3>
                    <p class="destination-count">892 properties</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =====================================================================
     FEATURED LISTINGS
     With liquid glass cards and stagger animation
     ===================================================================== -->
<section class="featured-listings-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Featured Stays</h2>
            <a href="/listings" class="liquid-glass-btn">View All</a>
        </div>

        <% if (featuredListings && featuredListings.length > 0) { %>
            <div class="listings-grid">
                <% featuredListings.forEach((listing, index) => { %>
                    <div class="liquid-glass-card listing-card glass-interactive" 
                         style="animation-delay: <%= index * 0.1 %>s;">
                        <a href="/listings/<%= listing._id %>" class="card-link">
                            <div class="image-hover-zoom">
                                <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1571896349842-33c89424de2d' %>" 
                                     alt="<%= listing.title %>" 
                                     class="listing-image"
                                     loading="lazy">
                            </div>
                            <div class="liquid-glass-card-overlay">
                                <div class="listing-header">
                                    <h3 class="listing-title"><%= listing.title %></h3>
                                    <div class="listing-rating">
                                        <i class="fas fa-star"></i>
                                        <span><%= (Math.random() * (5.0 - 4.7) + 4.7).toFixed(2) %></span>
                                    </div>
                                </div>
                                <p class="listing-location">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <%= listing.location %>, <%= listing.country %>
                                </p>
                                <div class="listing-price">
                                    <span class="price-amount">₹<%= listing.price.toLocaleString() %></span>
                                    <span class="price-period">/ night</span>
                                </div>
                            </div>
                        </a>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="empty-state liquid-glass">
                <div class="empty-icon">
                    <i class="fas fa-map-marked-alt"></i>
                </div>
                <h3>No listings available</h3>
                <p>Start exploring by adding your first property</p>
                <a href="<%= currentUser ? '/listings/new' : '/login?redirect=/listings/new' %>" class="liquid-glass-btn liquid-glass-btn-primary">
                    Add Listing
                </a>
            </div>
        <% } %>
    </div>
</section>

<!-- =====================================================================
     PARALLAX CTA SECTION
     ===================================================================== -->
<section class="cta-section parallax-bg" 
         style="background-image: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920');"
         data-parallax="0.5">
    <div class="cta-overlay liquid-glass-strong">
        <div class="container text-center">
            <h2 class="cta-title">Ready to Start Your Journey?</h2>
            <p class="cta-subtitle">
                Join thousands of travelers discovering unique stays around the world
            </p>
            <div class="cta-actions">
                <a href="/listings" class="liquid-glass-btn liquid-glass-btn-primary liquid-refraction">
                    Explore Listings
                </a>
                <a href="<%= currentUser ? '/listings/new' : '/register?redirect=/listings/new' %>" class="liquid-glass-btn">
                    Become a Host
                </a>
            </div>
        </div>
    </div>
</section>

<style>
/* ===================================================================
   SCROLLYTELLING LAYOUT STYLES
   =================================================================== */

/* Hero Scroll Section */
.hero-scroll-section {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
}

#hero-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.3) 0%,
        rgba(0, 0, 0, 0.1) 50%,
        rgba(0, 0, 0, 0.3) 100%
    );
}

.hero-content {
    text-align: center;
    color: white;
    z-index: 2;
}

.hero-title {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
}

.gradient-text {
    background: linear-gradient(135deg, #FF385C, #0071E3, #9650FF);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-subtitle {
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    max-width: 600px;
    margin: 0 auto;
    opacity: 0.95;
}

/* Search Section */
.search-section {
    padding: 80px 0;
    position: relative;
    margin-top: -80px;
}

.search-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    align-items: end;
}

.search-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.search-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--airbnb-black);
}

.search-action {
    display: flex;
    align-items: flex-end;
}

/* Features Section */
.features-section {
    min-height: 300vh;
    position: relative;
}

.feature-item {
    height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.feature-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    filter: brightness(0.7);
}

.feature-content {
    max-width: 600px;
    padding: 60px;
    text-align: center;
    z-index: 2;
}

.feature-icon {
    font-size: 4rem;
    color: var(--airbnb-red);
    margin-bottom: 2rem;
}

.feature-title {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: white;
}

.feature-description {
    font-size: 1.3rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.95);
}

/* Destination Showcase */
.destination-showcase {
    padding: 120px 0;
    overflow: hidden;
}

.destination-scroll-wrapper {
    display: flex;
    gap: 32px;
    padding: 20px 0;
}

.destination-card {
    flex: 0 0 400px;
    height: 500px;
    position: relative;
}

.destination-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 20px;
}

.destination-name {
    font-size: 2rem;
    font-weight: 700;
    color: white;
    margin-bottom: 0.5rem;
}

.destination-count {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.1rem;
}

/* Featured Listings */
.featured-listings-section {
    padding: 120px 0;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 48px;
}

.section-title {
    font-size: 2.5rem;
    font-weight: 700;
}

.listings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 32px;
}

.listing-card {
    height: 450px;
}

.listing-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 20px;
}

.listing-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 12px;
}

.listing-title {
    font-size: 1.3rem;
    font-weight: 600;
    color: white;
    margin: 0;
}

.listing-rating {
    display: flex;
    align-items: center;
    gap: 4px;
    color: #FFD700;
    font-weight: 600;
}

.listing-location {
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.listing-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
}

.price-amount {
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
}

.price-period {
    color: rgba(255, 255, 255, 0.8);
}

/* CTA Section */
.cta-section {
    padding: 200px 0;
    position: relative;
    background-attachment: fixed;
}

.cta-overlay {
    padding: 80px 40px;
    margin: 0 auto;
    max-width: 800px;
}

.cta-title {
    font-size: 3rem;
    font-weight: 700;
    color: white;
    margin-bottom: 1.5rem;
}

.cta-subtitle {
    font-size: 1.5rem;
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: 3rem;
}

.cta-actions {
    display: flex;
    gap: 20px;
    justify-content: center;
}

/* Empty State */
.empty-state {
    text-align: center;
    padding: 80px 40px;
    max-width: 500px;
    margin: 0 auto;
}

.empty-icon {
    font-size: 4rem;
    color: var(--airbnb-gray);
    margin-bottom: 2rem;
}

/* Responsive */
@media (max-width: 768px) {
    .search-grid {
        grid-template-columns: 1fr;
    }
    
    .destination-card {
        flex: 0 0 300px;
        height: 400px;
    }
    
    .listings-grid {
        grid-template-columns: 1fr;
    }
    
    .cta-actions {
        flex-direction: column;
    }
}
</style>
