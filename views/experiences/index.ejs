<script>
function openSearchModal() {
    document.getElementById('searchModalOverlay').classList.add('active');
    document.body.style.overflow = 'hidden';
}

function closeSearchModal() {
    document.getElementById('searchModalOverlay').classList.remove('active');
    document.body.style.overflow = '';
}

function openFilterDrawer() {
    document.getElementById('filterDrawer').classList.add('active');
}

function closeFilterDrawer() {
    document.getElementById('filterDrawer').classList.remove('active');
}

function setRating(value) {
    document.getElementById('minRatingInput').value = value;
    document.querySelectorAll('.rating-btn').forEach(btn => btn.classList.remove('active'));
    event.target.classList.add('active');
}

function resetFilters() {
    window.location.href = '/experiences';
}

function handleSortChange(value) {
    const url = new URL(window.location);
    url.searchParams.set('sort', value);
    window.location.href = url.toString();
}

// Close modal on overlay click
document.getElementById('searchModalOverlay')?.addEventListener('click', function(e) {
    if (e.target === this) {
        closeSearchModal();
    }
});

// Search trigger in navbar
document.querySelectorAll('.nav-pill[data-tab="experiences"]')?.forEach(pill => {
    pill.addEventListener('click', openSearchModal);
});

// FIX: Ensure hero title stays visible after animation
document.addEventListener('DOMContentLoaded', function() {
    const heroTitle = document.querySelector('.kinetic-hero-title');
    if (heroTitle) {
        // Add class after animation completes to lock in visible state
        heroTitle.addEventListener('animationend', function() {
            this.classList.add('animated');
            this.style.opacity = '1';
            this.style.transform = 'translateY(0)';
        }, { once: true });
        
        // Fallback: Force visibility after 2 seconds regardless
        setTimeout(function() {
            heroTitle.classList.add('animated');
            heroTitle.style.opacity = '1';
            heroTitle.style.transform = 'translateY(0)';
        }, 2000);
    }
});
</script>

