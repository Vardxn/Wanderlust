<% layout('../layouts/boilerplate') %>

<div class="container mt-4">
    <!-- Hero Section -->
    <div class="hero-section py-5 text-white text-center mb-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 15px;">
        <div class="container">
            <h1 class="display-4 fw-bold mb-4">Welcome to Wanderlust</h1>
            <p class="lead mb-5">Discover amazing places to stay around the world</p>
            <a href="/listings" class="btn btn-primary btn-lg px-4">Explore All Listings</a>
        </div>
    </div>

    <!-- Featured Listings Section -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="fw-bold mb-0">Featured Listings</h2>
            <a href="/listings" class="text-decoration-none">Show all</a>
        </div>
        
        <% if (listings && listings.length > 0) { %>
            <div class="property-scroll-container">
                <div class="property-scroll d-flex"
                    style="overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; gap: 24px; padding-bottom: 20px;">
                    <% listings.forEach(listing => { %>
                        <div class="property-card-scroll" style="min-width: 270px; scroll-snap-align: start;">
                            <a href="/listings/<%= listing._id %>" class="text-decoration-none text-reset">
                                <div class="position-relative">
                                    <% if (listing.reviews && listing.reviews.length > 3) { %>
                                        <div class="guest-favorite-badge">Guest favourite</div>
                                    <% } %>
                                    <div class="card-image-container">
                                        <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1571896349842-33c89424de2d' %>"
                                            alt="<%= listing.title %>" 
                                            class="property-main-image">
                                        <button class="favorite-btn" onclick="event.preventDefault();">
                                            <i class="far fa-heart"></i>
                                        </button>
                                        <div class="price-tag">₹<%= listing.price.toLocaleString() %></div>
                                    </div>
                                    <div class="property-info mt-2">
                                        <div class="property-header">
                                            <h5 class="property-title"><%= listing.title %></h5>
                                            <div class="property-rating">
                                                <i class="fas fa-star"></i>
                                                <span><%= (Math.random() * (5.0 - 4.5) + 4.5).toFixed(2) %></span>
                                            </div>
                                        </div>
                                        <p class="property-subtitle"><%= listing.description.substring(0, 50) %><%= listing.description.length > 50 ? '...' : '' %></p>
                                        <p class="property-dates">
                                            <%= listing.location %>, <%= listing.country %>
                                        </p>
                                        <p class="property-price">
                                            <span class="price-amount">₹<%= listing.price.toLocaleString() %></span> night
                                        </p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <h4 class="text-muted">No listings available</h4>
                <p class="text-muted">Please check your database connection and seed the data.</p>
                <a href="/listings/new" class="btn btn-outline-primary">Add First Listing</a>
            </div>
        <% } %>
    </section>

    <!-- Dynamic Location-Based Sections -->
    <% if (topLocations && topLocations.length > 0) { %>
        <% topLocations.forEach((location, index) => { %>
            <% const locationListings = listingsByLocation[location].slice(0, 10); %>
            <%- include('./includes/location-section', { 
                title: `Popular homes in ${location}`,
                location: location,
                listings: locationListings
            }) %>
        <% }) %>
    <% } %>

    <!-- Static City Showcase Sections (Optional) -->
    <%# You can keep these for design variety or remove them %>
    <%# include('./sections/new-york') %>
    <%# include('./sections/paris') %>
</div>