<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Performance: DNS Prefetch for external resources -->
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    
    <title>
        <%= typeof pageTitle !=='undefined' ? pageTitle + ' - ' : '' %>Wanderlust
    </title>

    <!-- Critical CSS - Minified inline -->
    <style>body{margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#0A0E1A;color:#fff;overflow-x:hidden}.liquid-glass-nav-clean{position:fixed;top:0;left:0;width:100%;z-index:9999;background:transparent}.nav-container{max-width:1920px;margin:0 auto;padding:16px 40px;display:flex;align-items:center;justify-content:space-between}.logo-text-clean{font-size:1.5rem;font-weight:900;background:linear-gradient(135deg,#60A5FA,#F9FAFB);-webkit-background-clip:text;-webkit-text-fill-color:transparent}.nav-center-clean{display:flex;gap:8px;background:rgba(255,255,255,.05);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,.08);border-radius:50px;padding:6px}.experiences-main,.listings-main{padding-top:100px;min-height:100vh}img{max-width:100%;height:auto}*{box-sizing:border-box}</style>

    <!-- Preload critical fonts -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" as="style">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap">

    <!-- Critical CSS Libraries -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <!-- Custom CSS - Immediate load for critical styles -->
    <link rel="stylesheet" href="/CSS/styles.css">
    <link rel="stylesheet" href="/CSS/navbar-clean.css">
    <link rel="stylesheet" href="/CSS/liquid-glass-system.css">
    <link rel="stylesheet" href="/CSS/liquid-glass-homepage.css">
    <link rel="stylesheet" href="/CSS/trending-features.css">

</head>

<body>
    <!-- Navigation -->
    <%- include('../includes/navbar') %>

        <!-- Main Content -->
        <main>
            <%- body %>
        </main>

        <!-- Footer -->
        <%- include('../includes/footer') %>

            <% if (!currentUser) { %>
                <div id="authScrollPrompt" class="auth-scroll-prompt" aria-hidden="true">
                    <div class="auth-scroll-card">
                        <h3>Unlock full Wanderlust</h3>
                        <p>Sign up or log in to book, save, and host. You can keep browsing without logging in.</p>
                        <div class="auth-scroll-actions">
                            <a href="/login" class="btn btn-primary btn-sm">Log in</a>
                            <a href="/register" class="btn btn-outline-light btn-sm">Sign up</a>
                            <button type="button" id="skipAuthPrompt" class="btn btn-link btn-sm">Skip for now</button>
                        </div>
                    </div>
                </div>

                <style>
                    .auth-scroll-prompt {
                        position: fixed;
                        right: 20px;
                        bottom: 20px;
                        z-index: 10030;
                        width: min(360px, calc(100vw - 40px));
                        opacity: 0;
                        transform: translateY(24px);
                        pointer-events: none;
                        transition: opacity 0.25s ease, transform 0.25s ease;
                    }

                    .auth-scroll-prompt.show {
                        opacity: 1;
                        transform: translateY(0);
                        pointer-events: auto;
                    }

                    .auth-scroll-card {
                        background: rgba(18, 18, 18, 0.88);
                        border: 1px solid rgba(255, 255, 255, 0.14);
                        border-radius: 14px;
                        padding: 16px;
                        backdrop-filter: blur(14px);
                        -webkit-backdrop-filter: blur(14px);
                        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.28);
                    }

                    .auth-scroll-card h3 {
                        margin: 0 0 6px;
                        font-size: 1.05rem;
                        font-weight: 700;
                    }

                    .auth-scroll-card p {
                        margin: 0 0 12px;
                        color: rgba(255, 255, 255, 0.78);
                        font-size: 0.92rem;
                        line-height: 1.45;
                    }

                    .auth-scroll-actions {
                        display: flex;
                        gap: 8px;
                        align-items: center;
                        flex-wrap: wrap;
                    }

                    #skipAuthPrompt {
                        color: rgba(255, 255, 255, 0.72);
                        text-decoration: none;
                        padding-inline: 4px;
                    }

                    #skipAuthPrompt:hover {
                        color: #fff;
                    }
                </style>
            <% } %>

            <!-- Performance: Defer JavaScript -->
            <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            
            <!-- Custom JS - Load with defer for better performance -->
            <script defer src="/js/performance-optimizer.js"></script>
            <script defer src="/js/airbnb-components.js"></script>

            <% if (!currentUser) { %>
                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        const promptEl = document.getElementById('authScrollPrompt');
                        const skipBtn = document.getElementById('skipAuthPrompt');
                        if (!promptEl || !skipBtn) return;

                        const STORAGE_KEY = 'wanderlust_auth_prompt_skip_until';
                        const skipUntil = Number(localStorage.getItem(STORAGE_KEY) || '0');
                        if (Date.now() < skipUntil) {
                            return;
                        }

                        let hasShown = false;
                        function maybeShowPrompt() {
                            if (hasShown) return;
                            if ((window.scrollY || window.pageYOffset || 0) > 450) {
                                hasShown = true;
                                promptEl.classList.add('show');
                                promptEl.setAttribute('aria-hidden', 'false');
                            }
                        }

                        skipBtn.addEventListener('click', function () {
                            const oneDay = 24 * 60 * 60 * 1000;
                            localStorage.setItem(STORAGE_KEY, String(Date.now() + oneDay));
                            promptEl.classList.remove('show');
                            promptEl.setAttribute('aria-hidden', 'true');
                        });

                        window.addEventListener('scroll', maybeShowPrompt, { passive: true });
                        maybeShowPrompt();
                    });
                </script>
            <% } %>
</body>

</html>