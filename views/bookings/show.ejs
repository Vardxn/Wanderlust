<% layout('layouts/boilerplate') %>

<div class="container my-5">
    <div class="row">
        <!-- Booking Details Card -->
        <div class="col-lg-8 mx-auto">
            <!-- Status Badge -->
            <div class="text-center mb-4">
                <% if (booking.status === 'confirmed') { %>
                    <span class="badge bg-success fs-5 px-4 py-2"><i class="fas fa-check-circle"></i> Booking Confirmed</span>
                <% } else if (booking.status === 'pending') { %>
                    <span class="badge bg-warning text-dark fs-5 px-4 py-2"><i class="fas fa-clock"></i> Pending Confirmation</span>
                <% } else if (booking.status === 'cancelled') { %>
                    <span class="badge bg-danger fs-5 px-4 py-2"><i class="fas fa-times-circle"></i> Cancelled</span>
                <% } else if (booking.status === 'completed') { %>
                    <span class="badge bg-info fs-5 px-4 py-2"><i class="fas fa-flag-checkered"></i> Completed</span>
                <% } else if (booking.status === 'rejected') { %>
                    <span class="badge bg-dark fs-5 px-4 py-2"><i class="fas fa-ban"></i> Rejected</span>
                <% } %>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h2 class="card-title mb-4"><i class="fas fa-file-alt"></i> Booking Details</h2>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Booking ID</label>
                            <div class="fw-bold"><%= booking._id %></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Booked On</label>
                            <div class="fw-bold"><%= new Date(booking.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %></div>
                        </div>
                    </div>
                    
                    <hr>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small"><i class="fas fa-calendar-check"></i> Check-in</label>
                            <div class="fw-bold fs-5"><%= new Date(booking.checkIn).toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) %></div>
                            <small class="text-muted">After 2:00 PM</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small"><i class="fas fa-calendar-times"></i> Checkout</label>
                            <div class="fw-bold fs-5"><%= new Date(booking.checkOut).toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) %></div>
                            <small class="text-muted">Before 11:00 AM</small>
                        </div>
                    </div>
                    
                    <div class="alert alert-info">
                        <i class="fas fa-moon"></i> <%= Math.ceil((new Date(booking.checkOut) - new Date(booking.checkIn)) / (1000 * 60 * 60 * 24)) %> night<%= Math.ceil((new Date(booking.checkOut) - new Date(booking.checkIn)) / (1000 * 60 * 60 * 24)) > 1 ? 's' : '' %> stay
                    </div>
                    
                    <hr>
                    
                    <h5 class="mb-3"><i class="fas fa-users"></i> Guest Information</h5>
                    <div class="row">
                        <div class="col-6 col-md-3 mb-2">
                            <small class="text-muted">Adults</small>
                            <div class="fw-bold"><%= booking.guests.adults %></div>
                        </div>
                        <div class="col-6 col-md-3 mb-2">
                            <small class="text-muted">Children</small>
                            <div class="fw-bold"><%= booking.guests.children %></div>
                        </div>
                        <div class="col-6 col-md-3 mb-2">
                            <small class="text-muted">Infants</small>
                            <div class="fw-bold"><%= booking.guests.infants %></div>
                        </div>
                        <% if (booking.guests.pets > 0) { %>
                        <div class="col-6 col-md-3 mb-2">
                            <small class="text-muted">Pets</small>
                            <div class="fw-bold"><%= booking.guests.pets %></div>
                        </div>
                        <% } %>
                    </div>
                    
                    <% if (booking.specialRequests) { %>
                    <div class="mt-3">
                        <small class="text-muted">Special Requests</small>
                        <div class="alert alert-light mt-1"><%= booking.specialRequests %></div>
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- Property Details Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h4 class="card-title mb-4"><i class="fas fa-home"></i> Property Details</h4>
                    
                    <div class="row align-items-center">
                        <div class="col-md-4 mb-3">
                            <% if (booking.listing.images && booking.listing.images.length > 0) { %>
                                <img src="<%= booking.listing.images[0].url %>" alt="<%= booking.listing.title %>" class="img-fluid rounded">
                            <% } else { %>
                                <img src="https://via.placeholder.com/300x200?text=No+Image" alt="No image" class="img-fluid rounded">
                            <% } %>
                        </div>
                        <div class="col-md-8">
                            <h5 class="fw-bold"><%= booking.listing.title %></h5>
                            <p class="text-muted mb-2"><i class="fas fa-map-marker-alt"></i> <%= booking.listing.location %></p>
                            <p class="mb-2"><%= booking.listing.description.substring(0, 150) %>...</p>
                            <a href="/listings/<%= booking.listing._id %>" class="btn btn-sm btn-outline-primary">View Property</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Price Breakdown Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h4 class="card-title mb-4"><i class="fas fa-rupee-sign"></i> Payment Details</h4>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span>₹<%= booking.pricing.nightlyRate.toLocaleString() %> x <%= Math.ceil((new Date(booking.checkOut) - new Date(booking.checkIn)) / (1000 * 60 * 60 * 24)) %> night(s)</span>
                        <span class="fw-bold">₹<%= booking.pricing.basePrice.toLocaleString() %></span>
                    </div>
                    
                    <% if (booking.pricing.cleaningFee > 0) { %>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Cleaning fee</span>
                        <span class="fw-bold">₹<%= booking.pricing.cleaningFee.toLocaleString() %></span>
                    </div>
                    <% } %>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span>Service fee</span>
                        <span class="fw-bold">₹<%= booking.pricing.serviceFee.toLocaleString() %></span>
                    </div>
                    
                    <% if (booking.pricing.taxes > 0) { %>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Taxes (12% GST)</span>
                        <span class="fw-bold">₹<%= booking.pricing.taxes.toLocaleString() %></span>
                    </div>
                    <% } %>
                    
                    <% if (booking.pricing.discount > 0) { %>
                    <div class="d-flex justify-content-between mb-2 text-success">
                        <span><%= booking.pricing.discountType.charAt(0).toUpperCase() + booking.pricing.discountType.slice(1) %> discount</span>
                        <span class="fw-bold">-₹<%= booking.pricing.discount.toLocaleString() %></span>
                    </div>
                    <% } %>
                    
                    <hr>
                    
                    <div class="d-flex justify-content-between fs-4">
                        <span class="fw-bold">Total (INR)</span>
                        <span class="fw-bold text-primary">₹<%= booking.pricing.total.toLocaleString() %></span>
                    </div>
                    
                    <div class="mt-3">
                        <small class="text-muted">Payment Status</small>
                        <div class="fw-bold">
                            <% if (booking.payment.status === 'paid') { %>
                                <span class="text-success"><i class="fas fa-check-circle"></i> Paid</span>
                            <% } else if (booking.payment.status === 'pending') { %>
                                <span class="text-warning"><i class="fas fa-clock"></i> Pending</span>
                            <% } else if (booking.payment.status === 'refunded') { %>
                                <span class="text-info"><i class="fas fa-undo"></i> Refunded</span>
                            <% } else { %>
                                <span class="text-danger"><i class="fas fa-times-circle"></i> Failed</span>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="/bookings" class="btn btn-outline-secondary">
                            <i class="fas fa-list"></i> My Bookings
                        </a>
                        
                        <% if (booking.status === 'confirmed' || booking.status === 'pending') { %>
                            <% 
                                const now = new Date();
                                const checkIn = new Date(booking.checkIn);
                                const hoursUntilCheckIn = (checkIn - now) / (1000 * 60 * 60);
                            %>
                            
                            <% if (hoursUntilCheckIn >= 48) { %>
                                <a href="/bookings/<%= booking._id %>/modify" class="btn btn-warning">
                                    <i class="fas fa-edit"></i> Modify Booking
                                </a>
                            <% } %>
                            
                            <form action="/bookings/<%= booking._id %>/cancel" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this booking?')">
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-times"></i> Cancel Booking
                                </button>
                            </form>
                        <% } %>
                        
                        <a href="/bookings/<%= booking._id %>/invoice" class="btn btn-success" target="_blank">
                            <i class="fas fa-file-invoice"></i> Download Invoice
                        </a>
                        
                        <button class="btn btn-outline-primary" onclick="window.print()">
                            <i class="fas fa-print"></i> Print Confirmation
                        </button>
                        
                        <button class="btn btn-outline-info" onclick="shareBooking()">
                            <i class="fas fa-share-alt"></i> Share
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function shareBooking() {
    const bookingUrl = window.location.href;
    if (navigator.share) {
        navigator.share({
            title: 'My Booking - <%= booking.listing.title %>',
            text: 'Check out my booking at <%= booking.listing.title %>',
            url: bookingUrl
        });
    } else {
        // Fallback - copy to clipboard
        navigator.clipboard.writeText(bookingUrl).then(() => {
            alert('Booking link copied to clipboard!');
        });
    }
}
</script>

<style>
    @media print {
        .btn, form, .alert, nav, footer {
            display: none !important;
        }
    }
</style>
