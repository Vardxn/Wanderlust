    font-size: 0.85rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

/* === VIBRANT GRADIENT SEARCH BUTTON === */
.hero-search-btn {
    background: linear-gradient(135deg, #E91E63, #9C27B0) !important;
    color: white !important;
    border: none !important;
    padding: 16px 32px !important;
    border-radius: 12px !important;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
    font-size: 1rem !important;
    font-weight: 700 !important;
    cursor: pointer !important;
    transition: all 0.3s ease-in-out !important;
    box-shadow: 0 4px 16px rgba(233, 30, 99, 0.4) !important;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.hero-search-btn:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 24px rgba(233, 30, 99, 0.6) !important;
    background: linear-gradient(135deg, #D81B60, #8E24AA) !important;
}

.hero-search-btn i {
    margin-right: 8px;
}

/* === ENHANCED OVERLAY FOR DESTINATION CARDS === */
.premium-gradient-overlay {
    background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.75) 0%,
        rgba(0, 0, 0, 0.4) 50%,
        transparent 100%
    ) !important;
}

/* Top Feature Cards - Elegant Hover Effects */
.feature-card-top {
    cursor: pointer;
    position: relative;
    overflow: hidden;
}

.feature-card-top:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35) !important;
}

.feature-card-top::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
    transition: left 0.5s ease;
}

.feature-card-top:hover::before {
    left: 100%;
}

/* Hero Title Animation Styles */
.hero-search-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem) !important;
    font-weight: 800 !important;
    letter-spacing: -0.02em !important;
    color: #ffffff !important; /* Solid white color */
    margin-bottom: 16px !important;
    line-height: 1.1 !important;
    opacity: 1 !important;
    transform: translateY(0) !important;
    display: block !important; /* Force display */
    visibility: visible !important; /* Force visibility */
}

.hero-search-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem) !important;
    color: rgba(255, 255, 255, 0.8) !important;
    margin-bottom: 32px !important;
    opacity: 1 !important;
    transform: translateY(0) !important;
    display: block !important;
    visibility: visible !important;
}

/* Remove all animations temporarily for debugging */
/* Remove all animations - make everything visible immediately */
.micro-lift {
    opacity: 1 !important; /* Always visible */
    transform: translateY(0) !important;
}

.search-field-hero,
.search-action-hero {
    opacity: 1 !important; /* Always visible */
    transform: translateX(0) !important;
}

.expressive-heading-sans {
    opacity: 1 !important; /* Always visible */
    transform: translateY(0) !important;
}


/* Brutalist heading */
.brutalist-heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: white;
    opacity: 0;
    animation: brutalistSlide 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@keyframes brutalistSlide {
    0% {
        opacity: 0;
        transform: translateX(-30px);
    }
    100% {
        opacity: 1;
        transform: translateX(0);
    }
}
</style>

