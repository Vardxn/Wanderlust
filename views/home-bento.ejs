<% layout('../layouts/boilerplate') %>

<style>
/* Modern Typography - Inter Font */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

/* === HERO SECTION TYPOGRAPHY === */
.hero-search-title {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
    font-size: clamp(2.5rem, 5vw, 4rem) !important;
    font-weight: 900 !important;
    letter-spacing: -0.02em !important;
    color: #ffffff !important;
    margin-bottom: 12px !important;
    line-height: 1.1 !important;
    opacity: 1 !important;
    display: block !important;
    visibility: visible !important;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
}

.hero-search-subtitle {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
    font-size: 1.2rem !important;
    color: rgba(255, 255, 255, 0.9) !important;
    margin-bottom: 40px !important;
    font-weight: 500 !important;
    opacity: 1 !important;
    display: block !important;
    visibility: visible !important;
}

/* === INTERACTIVE FEATURE CARDS WITH SMOOTH LIFT EFFECT === */
.bento-small.bento-featured-premium {
    transition: all 0.3s ease-in-out !important;
}

.bento-small.bento-featured-premium:hover {
    transform: translateY(-5px) !important;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6) !important;
}

/* === MODERN SEARCH INPUTS WITH SUNKEN EFFECT === */
.liquid-glass-input-hero {
    background: rgba(255, 255, 255, 0.05) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: 12px;
    padding: 14px 16px;
    color: #ffffff !important;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
    font-size: 0.95rem;
    transition: all 0.3s ease-in-out;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.15);
}

.liquid-glass-input-hero:focus {
    background: rgba(255, 255, 255, 0.08) !important;
    border-color: rgba(233, 30, 99, 0.5) !important;
    box-shadow: 
        inset 0 2px 4px rgba(0, 0, 0, 0.15),
        0 0 0 3px rgba(233, 30, 99, 0.15) !important;
    outline: none;
}

.liquid-glass-input-hero::placeholder {
    color: rgba(255, 255, 255, 0.5);
}

.search-label-hero {
