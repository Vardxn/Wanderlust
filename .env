# ============================================================================
# Wanderlust Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION SETTINGS
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
APP_NAME=Wanderlust

# ----------------------------------------------------------------------------
# MONGODB CONFIGURATION (Current Database)
# ----------------------------------------------------------------------------
MONGODB_URL=mongodb://127.0.0.1:27017/wanderlust
MONGODB_TEST_URL=mongodb://127.0.0.1:27017/wanderlust_test
MONGODB_URI=mongodb://localhost:27017/wanderlust

# MongoDB Atlas (for production)
# MONGODB_ATLAS_URL=mongodb+srv://username:password@cluster.mongodb.net/wanderlust?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/wanderlust

# ----------------------------------------------------------------------------
# POSTGRESQL CONFIGURATION (Future Migration)
# ----------------------------------------------------------------------------
# PostgreSQL connection settings
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=wanderlust
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
PG_SSL=false

# Connection pool settings
PG_POOL_MIN=2
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT=30000

# PostgreSQL connection string (alternative format)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/wanderlust

# ----------------------------------------------------------------------------
# SESSION & AUTHENTICATION
# ----------------------------------------------------------------------------
SESSION_SECRET=wanderlust-super-secret-key-change-this-in-production-2024
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRY=7d

# Cookie settings
COOKIE_MAX_AGE=604800000
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true

# ----------------------------------------------------------------------------
# CLOUDINARY (Image Storage)
# ----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----------------------------------------------------------------------------
# MAPBOX (Maps & Geocoding)
# ----------------------------------------------------------------------------
MAPBOX_TOKEN=your_mapbox_token_here

# ----------------------------------------------------------------------------
# EMAIL SERVICE (for booking confirmations, reminders)
# ----------------------------------------------------------------------------
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@wanderlust.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# SendGrid (alternative)
# SENDGRID_API_KEY=your_sendgrid_api_key

# ----------------------------------------------------------------------------
# PAYMENT GATEWAY (Stripe)
# ----------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLIC_KEY=

# ----------------------------------------------------------------------------
# CORS SETTINGS
# ----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----------------------------------------------------------------------------
# FILE UPLOAD LIMITS
# ----------------------------------------------------------------------------
MAX_FILE_SIZE=5242880
MAX_FILES_PER_UPLOAD=10

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ----------------------------------------------------------------------------
# REDIS (for caching and session storage)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ----------------------------------------------------------------------------
# BOOKING & BUSINESS LOGIC
# ----------------------------------------------------------------------------
SERVICE_FEE_PERCENTAGE=14
BOOKING_REMINDER_DAYS_BEFORE=3,7,1
AUTO_CANCEL_PENDING_HOURS=24

# ----------------------------------------------------------------------------
# DEVELOPMENT TOOLS
# ----------------------------------------------------------------------------
DEBUG=wanderlust:*
ENABLE_QUERY_LOGGING=true
ENABLE_ERROR_STACK_TRACE=true

# ----------------------------------------------------------------------------
# GOOGLE MAPS API
# ----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# Site URL (for email links)
NEXT_PUBLIC_SITE_URL=http://localhost:8080
