<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof pageTitle !=='undefined' ? pageTitle + ' - ' : '' %>Wanderlust
    </title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/CSS/styles.css">
    <!-- Modern Color System -->
    <link rel="stylesheet" href="/CSS/modern-colors.css">
    <!-- Dark Theme - Applied First for Base Styles -->
    <link rel="stylesheet" href="/CSS/dark-theme.css">
    <!-- Dark Theme Enhancements -->
    <link rel="stylesheet" href="/CSS/dark-theme-enhancements.css">
    <!-- Clean Navbar -->
    <link rel="stylesheet" href="/CSS/navbar-clean.css">
    <!-- Liquid Glass Homepage -->
    <link rel="stylesheet" href="/CSS/liquid-glass-homepage.css">
    <!-- Liquid Glass Listings -->
    <link rel="stylesheet" href="/CSS/listings-liquid-glass.css">
    <!-- Premium Enhancements CSS -->
    <link rel="stylesheet" href="/CSS/premium-enhancements.css">
    <!-- Liquid Glass System CSS -->
    <link rel="stylesheet" href="/CSS/liquid-glass-system.css">
    <!-- Trending Features CSS -->
    <link rel="stylesheet" href="/CSS/trending-features.css">
</head>

<body>
    <!-- Navigation -->
    <%- include('../views/includes/navbar') %>

        <!-- Main Content -->
        <main>
            <%- body %>
        </main>

        <!-- Footer -->
        <%- include('../views/includes/footer') %>

            <% if (!currentUser) { %>
                <div id="authScrollPrompt" class="auth-scroll-prompt" aria-hidden="true">
                    <div class="auth-scroll-card">
                        <h3>Unlock full Wanderlust</h3>
                        <p>Sign up or log in to book, save, and host. You can keep browsing without logging in.</p>
                        <div class="auth-scroll-actions">
                            <a href="/login" class="btn btn-primary btn-sm">Log in</a>
                            <a href="/register" class="btn btn-outline-light btn-sm">Sign up</a>
                            <button type="button" id="skipAuthPrompt" class="btn btn-link btn-sm">Skip for now</button>
                        </div>
                    </div>
                </div>

                <style>
                    .auth-scroll-prompt {
                        position: fixed;
                        right: 20px;
                        bottom: 20px;
                        z-index: 10030;
                        width: min(360px, calc(100vw - 40px));
                        opacity: 0;
                        transform: translateY(24px);
                        pointer-events: none;
                        transition: opacity 0.25s ease, transform 0.25s ease;
                    }

                    .auth-scroll-prompt.show {
                        opacity: 1;
                        transform: translateY(0);
                        pointer-events: auto;
                    }

                    .auth-scroll-card {
                        background: rgba(18, 18, 18, 0.88);
                        border: 1px solid rgba(255, 255, 255, 0.14);
                        border-radius: 14px;
                        padding: 16px;
                        backdrop-filter: blur(14px);
                        -webkit-backdrop-filter: blur(14px);
                        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.28);
                    }

                    .auth-scroll-card h3 {
                        margin: 0 0 6px;
                        font-size: 1.05rem;
                        font-weight: 700;
                    }

                    .auth-scroll-card p {
                        margin: 0 0 12px;
                        color: rgba(255, 255, 255, 0.78);
                        font-size: 0.92rem;
                        line-height: 1.45;
                    }

                    .auth-scroll-actions {
                        display: flex;
                        gap: 8px;
                        align-items: center;
                        flex-wrap: wrap;
                    }

                    #skipAuthPrompt {
                        color: rgba(255, 255, 255, 0.72);
                        text-decoration: none;
                        padding-inline: 4px;
                    }

                    #skipAuthPrompt:hover {
                        color: #fff;
                    }
                </style>
            <% } %>

            <!-- Bootstrap JS -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            <!-- GSAP & ScrollTrigger -->
            <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
            <!-- Premium Animations JS -->
            <script src="/js/premium-animations.js"></script>
            <!-- Scrollytelling JS -->
            <script src="/js/scrollytelling.js"></script>
            <!-- Trending Features JS -->
            <script src="/js/trending-features.js"></script>

            <% if (!currentUser) { %>
                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        const promptEl = document.getElementById('authScrollPrompt');
                        const skipBtn = document.getElementById('skipAuthPrompt');
                        if (!promptEl || !skipBtn) return;

                        const STORAGE_KEY = 'wanderlust_auth_prompt_skip_until';
                        const skipUntil = Number(localStorage.getItem(STORAGE_KEY) || '0');
                        if (Date.now() < skipUntil) {
                            return;
                        }

                        let hasShown = false;
                        function maybeShowPrompt() {
                            if (hasShown) return;
                            if ((window.scrollY || window.pageYOffset || 0) > 450) {
                                hasShown = true;
                                promptEl.classList.add('show');
                                promptEl.setAttribute('aria-hidden', 'false');
                            }
                        }

                        skipBtn.addEventListener('click', function () {
                            const oneDay = 24 * 60 * 60 * 1000;
                            localStorage.setItem(STORAGE_KEY, String(Date.now() + oneDay));
                            promptEl.classList.remove('show');
                            promptEl.setAttribute('aria-hidden', 'true');
                        });

                        window.addEventListener('scroll', maybeShowPrompt, { passive: true });
                        maybeShowPrompt();
                    });
                </script>
            <% } %>
            
            <!-- Navbar Scroll Effect -->
            <script>
                // Navbar scroll effect
                window.addEventListener('scroll', function() {
                    const navbar = document.querySelector('.liquid-glass-nav-clean');
                    if (navbar) {
                        if (window.scrollY > 50) {
                            navbar.classList.add('scrolled');
                        } else {
                            navbar.classList.remove('scrolled');
                        }
                    }
                });
            </script>
</body>

</html>